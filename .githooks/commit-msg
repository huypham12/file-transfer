#!/bin/sh
# Git Hook: commit-msg
# Tự động kiểm tra định dạng commit theo chuẩn Conventional Commits của SecureShare (file-transfer)
# Hoạt động 100% bằng Shell thuần trong Git Bash - Không phụ thuộc Node.js hay bất kỳ runtime nào.

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Bỏ qua merge commit hoặc revert tự động
if echo "$FIRST_LINE" | grep -qE '^Merge branch|^Merge remote-tracking branch|^Revert '; then
  exit 0
fi

# Danh sách Types và Scopes được định nghĩa trong COMMIT_CONVENTION.md
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
SCOPES="ui|viewmodel|domain|policy|pairing|protocol|streaming|crypto|buffer|network|storage|database|service|app|build|docs|test|ci|config"

# Cú pháp chuẩn: type(scope): subject hoặc type: subject
PATTERN="^($TYPES)(\(($SCOPES)\))?: .+$"

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo "====================================================================="
  echo "❌ [GIT HOOK] Commit message không đúng chuẩn dự án SecureShare!"
  echo "====================================================================="
  echo "Nội dung vừa nhập: \"$FIRST_LINE\""
  echo ""
  echo "👉 Cú pháp chuẩn: <type>(<scope>): <subject>"
  echo "   Ví dụ đúng: chore(config): cập nhật git hook commit-msg"
  echo "               feat(crypto): tích hợp thuật toán HKDF sinh mã SAS"
  echo "               fix(network): xử lý socket timeout khi ngắt kết nối"
  echo ""
  echo "⚠️ LƯU Ý PHỔ BIẾN:"
  echo "  - 'config' là SCOPE (phạm vi), không phải TYPE (hành động)."
  echo "  - Khi sửa cấu hình dự án, hãy dùng: chore(config): ... hoặc build(config): ..."
  echo ""
  echo "📌 Danh sách TYPE  : $TYPES"
  echo "📌 Danh sách SCOPE : $SCOPES"
  echo ""
  echo "📖 Tra cứu hướng dẫn chi tiết tại: COMMIT_CONVENTION.md"
  echo "====================================================================="
  echo ""
  exit 1
fi

exit 0
